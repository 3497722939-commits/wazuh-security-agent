# Wazuh Indexer 连接配置
# 复制此文件为 .env 并填入真实密码
WAZUH_INDEXER_URL=https://192.168.174.137:9200
WAZUH_USERNAME=admin
WAZUH_PASSWORD=your_password_here

# Wazuh REST API（预留）
WAZUH_API_URL=https://192.168.174.137:55000

# 查询限制
WAZUH_MAX_RESULTS=500
WAZUH_LOOKBACK_HOURS=24
WAZUH_MAX_LOOKBACK_HOURS=168
WAZUH_VERIFY_SSL=false
